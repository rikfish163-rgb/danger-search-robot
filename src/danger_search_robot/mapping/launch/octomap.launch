<launch>

    <node pkg="octomap_server"
          type="octomap_server_node"
          name="octomap_server"
          output="screen">

        <param name="resolution" value="0.1"/>

        <param name="frame_id"
               value="camera_init"/>

        <remap from="cloud_in"
               to="/cloud_registered"/>

    </node>

</launch>
