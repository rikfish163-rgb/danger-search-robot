<launch>
  <!-- Stable simulator fallback: PointCloud2 + IMU, without the crashing Livox plugin. -->
  <arg name="rviz" default="false" />

  <rosparam command="load" file="$(find fast_lio)/config/marsim.yaml" />
  <param name="common/lid_topic" type="string" value="/livox/Pointcloud2" />
  <param name="common/imu_topic" type="string" value="/livox/imu" />
  <param name="preprocess/lidar_type" type="int" value="4" />
  <param name="preprocess/blind" type="double" value="0.20" />
  <param name="point_filter_num" type="int" value="3" />
  <param name="feature_extract_enable" type="bool" value="false" />
  <param name="max_iteration" type="int" value="3" />
  <param name="filter_size_surf" type="double" value="0.20" />
  <param name="filter_size_map" type="double" value="0.30" />
  <param name="cube_side_length" type="double" value="1000.0" />
  <param name="runtime_pos_log_enable" type="bool" value="false" />
  <!-- The odometry->TF bridge is the single camera_init -> body source. -->
  <param name="publish/tf_en" type="bool" value="false" />

  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" />

  <!-- Some simulator FAST-LIO builds publish /Odometry but omit camera_init -> body TF. -->
  <node pkg="danger_search_robot" type="odometry_tf_bridge.py"
        name="fastlio_odometry_tf_bridge" output="screen">
    <param name="odometry_topic" value="/Odometry" />
    <param name="parent_frame" value="camera_init" />
    <param name="child_frame" value="body" />
  </node>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
  </group>
</launch>
