<launch>
  <!-- Exploration goals are not sent when true. -->
  <arg name="exploration_dry_run" default="true"/>

  <!-- Run only the measured initial straight drive, then remain stopped. -->
  <arg name="initial_forward_only" default="false"/>

  <!-- Set false only when starting exploration from an already positioned robot. -->
  <arg name="initial_forward_enabled" default="true"/>

  <node pkg="danger_search_robot"
        type="graph_nbv_stage_b3_node.py"
        name="graph_nbv"
        output="screen"
        respawn="false">

    <rosparam command="load"
              file="$(find danger_search_robot)/exploration/graph_nbv/config/graph_nbv_stage_b3.yaml"/>

    <param name="dry_run" value="$(arg exploration_dry_run)"/>
    <param name="initial_forward_only" value="$(arg initial_forward_only)"/>
    <param name="initial_forward_enabled" value="$(arg initial_forward_enabled)"/>
  </node>
</launch>
