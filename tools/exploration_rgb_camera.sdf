<?xml version="1.0"?>
<sdf version="1.6">
  <model name="exploration_rgb_camera">
    <static>true</static>
    <link name="camera_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="rgb_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>
        <camera name="rgb">
          <horizontal_fov>1.0466666667</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
        </camera>
        <plugin name="exploration_camera_ros" filename="libgazebo_ros_camera.so">
          <robotNamespace>/exploration_camera</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>10.0</updateRate>
          <cameraName>exploration_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>exploration_camera_optical</frameName>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
